{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luna",
  "version": "0.2.6",
  "identifier": "com.luna.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Luna",
        "width": 400,
        "height": 560,
        "decorations": false,
        "center": true,
        "resizable": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "Korean"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxNzAxNjI4OUNDNkMzMkEKUldRcXc4YWNLQlp3SVZxREkxc1FDU0RQdkw4TTNUN3VVM0pldElUcUVRLzlEamdaRjlMWkdPT2IK",
      "endpoints": [
        "https://github.com/YukiLumiy/Luna/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
